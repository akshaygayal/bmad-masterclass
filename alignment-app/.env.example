# Copy to .env.local for local development. Never commit real values.
# In production these are set in Vercel project settings (Neon integration).

# Pooled connection used by the app at runtime (Neon: the -pooler host,
# PgBouncer transaction mode). Locally, your Homebrew Postgres 16 database.
DATABASE_URL=

# Direct (unpooled) connection used only for migrations (drizzle-kit).
# Locally this can be the same as DATABASE_URL.
DATABASE_URL_UNPOOLED=

# Secret for HMAC-signing access cookies (used from Story 1.2).
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Public origin used to build access links, e.g. http://localhost:3000
APP_ORIGIN=
